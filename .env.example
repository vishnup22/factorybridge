# Copy to .env for local overrides. Never commit .env. All values below are safe local defaults or placeholders.

# --- docker compose (local only; ports bind to 127.0.0.1) ---
POSTGRES_PASSWORD=factorybridge
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379

# --- backend ---
ENVIRONMENT=development
# Generate for any shared environment:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
JWT_TTL_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://factorybridge:factorybridge@127.0.0.1:55432/factorybridge
REDIS_URL=redis://127.0.0.1:6379/0

# Storage: local (dev) or s3 (production; any S3-compatible private bucket, e.g. Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=factorybridge-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=auto

# AI extraction: "fixture" (deterministic, no network) or "anthropic" (requires key + model)
AI_PROVIDER=fixture
ANTHROPIC_API_KEY=
AI_MODEL=
AI_DAILY_BUDGET_USD=2.0
AI_INPUT_COST_PER_MTOK_USD=3.0
AI_OUTPUT_COST_PER_MTOK_USD=15.0

# Optional: require X-Health-Token on /health/ready and /metrics
HEALTH_TOKEN=
DEMO_SEED_ENABLED=true
# Optional fixed demo password (>=16 chars in production). If unset, random passwords are generated and written to var/.
FB_DEMO_PASSWORD=

# --- frontend (build time) ---
VITE_API_BASE_URL=http://localhost:8000
